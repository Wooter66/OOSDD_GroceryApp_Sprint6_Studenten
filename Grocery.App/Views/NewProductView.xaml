<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Grocery.App.Views.NewProductView"
             Title="Nieuw product">
    <VerticalStackLayout Padding="20" Spacing="16">
        <Label Text="Naam" />
        <Entry Placeholder="Naam" Text="{Binding Name}" />
        <Label Text="Voorraad" />
        <Entry Placeholder="Voorraad" Keyboard="Numeric" Text="{Binding Stock}" />
        <Label Text="THT datum" />
        <DatePicker Date="{Binding ShelfLife}" />
        <Label Text="Prijs" />
        <Entry Placeholder="Prijs" Keyboard="Numeric" Text="{Binding Price}" />
        <Button Text="Product toevoegen" Command="{Binding AddProductCommand}" />
    </VerticalStackLayout>
</ContentPage>